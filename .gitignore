# rendered output lives in GitHub Releases, not in git
renders/
*.mp4
*.mov
*.wav
snapshots/
.hyperframes/
node_modules/
__pycache__/
.DS_Store
Thumbs.db
# ...except source assets Ishaan pushes for compositing (kept in git)
!assets/
!assets/**
# ...and the lemo-opuscar campaign archive (reference films + treatments)
!films/lemo-opuscar/
!films/lemo-opuscar/**
# ...and the sources plates (real product/hero/looks footage, kept in git)
!sources/
!sources/**
# ...and vendored reference tools (their demo clips are reference, kept in git)
!vendor/
!vendor/**

# Mixkit/Pixabay site-licensed audio: free to use in videos, not for raw redistribution
mixkit-*.mp3
pixabay-*.mp3

# MotionEasy workspace: build output and generated files
out/
.next/
*.tsbuildinfo
next-env.d.ts
apps/web/public/engine/
apps/web/public/media/
launch-remotion/out/
# raw screen captures (source media belongs in assets/ or sources/)
*.mkv
*.log
# ...except the engine's CC0 recordings (source assets the engine ships)
!packages/engine/assets/sounds/*.wav
# ...and the library card previews (site assets, regenerated by cli/previews.mjs)
!apps/web/public/previews/*.mp4

# music library: CC-BY tracks fetched on demand by cli/music.mjs (credits in music.gen.ts)
assets/audio/music/library/

# CaptionsEasy 30 s film media (generated by launch-remotion/scripts/prepare-ad30.sh)
launch-remotion/public/ad30/
launch-remotion/public/storyboard/

# local-only test music (copyrighted, never commit or publish)
assets/audio/test-local/

# third-party reference media (copyrighted; public repo)
sources/creators/
sources/references/

# Style folders: notes/specs are tracked, media stays local
styles/*/references/**
styles/*/music/**
styles/*/renders/**
styles/*/videos/**
!styles/*/videos/**/
!styles/*/videos/**/*.txt
styles/*/assets/**
styles/*/fonts/**/*.ttf
styles/*/fonts/**/*.otf
styles/*/fonts/**/*.woff*
!styles/*/**/.gitkeep
!styles/*/**/*.md
!styles/*/**/*.json

# local audio-extraction toolchain
.venv-audio/
styles/*/sfx/*.[mM][pP]3
styles/*/sfx/*.[wW][aA][vV]
styles/*/inbox/
